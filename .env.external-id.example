# Microsoft Entra External ID (customer tenant)
# Public client configuration only. Do not put secrets in this file.
ENTRA_TENANT_NAME=your-external-tenant-subdomain
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_POLICY_NAME=signupsignin
ENTRA_AUTHORITY=https://your-external-tenant-subdomain.ciamlogin.com/
ENTRA_REDIRECT_URI=http://localhost:5173/auth/callback
ENTRA_IOS_BUNDLE_ID=com.example.product
ENTRA_IOS_REDIRECT_URI=msauth.com.example.product://auth
ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# AuthPlatform iOS device authorization grant (public client; no client secret)
ENTRA_IOS_TENANT_SUBDOMAIN=your-external-tenant-subdomain
ENTRA_IOS_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_IOS_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_IOS_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Vapor API: validate the delegated access token issued for the API app registration
MICROSOFT_TENANT_SUBDOMAIN=your-external-tenant-subdomain
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_API_AUDIENCE=00000000-0000-0000-0000-000000000000
MICROSOFT_API_SCOPE_NAME=access_as_user

# Vite SPA equivalents (all VITE_ values are public and shipped to browsers)
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_AUTHORITY=https://your-external-tenant-subdomain.ciamlogin.com/
VITE_ENTRA_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Server-only secrets belong in a managed secret store, never VITE_ variables.
# ENTRA_WEB_CLIENT_SECRET=
