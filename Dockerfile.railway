# Railway build context is the repository root; keep this separate from the
# AuthPlatform/Server/Dockerfile used by Render/Fly configurations.
FROM swift:6.2-noble AS build
WORKDIR /build

COPY AuthPlatform/Server/Package.swift ./Package.swift
RUN swift package resolve

COPY AuthPlatform/Server/Sources ./Sources
COPY AuthPlatform/Server/Tests ./Tests
RUN swift build -c release

FROM swift:6.2-noble AS runtime
WORKDIR /app
COPY --from=build /build/.build/release/App /app/App

ENV HOST=0.0.0.0
ENV PORT=8080
EXPOSE 8080

# Run migrations against the direct PostgreSQL URL before serving requests.
CMD ["sh", "-c", ": \"\${DATABASE_URL:?DATABASE_URL is required}\"; : \"\${DIRECT_DATABASE_URL:?DIRECT_DATABASE_URL is required}\"; DATABASE_URL=\"$DIRECT_DATABASE_URL\" /app/App migrate --yes && exec /app/App"]
